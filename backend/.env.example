# Example .env file for ManagePetro Backend
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED API KEYS
# =============================================================================

# Weather API Key (required)
# Get your free key at: https://www.weatherapi.com
WEATHER_API_KEY=your_weather_api_key_here

# TomTom API Key (required)
# Get your free key at: https://developer.tomtom.com
TOMTOM_API_KEY=your_tomtom_api_key_here

# Google Gemini API Key (required)
# Get your free key at: https://makersuite.google.com/app/apikey
# Note: Legacy variable name "gemenikey" is also supported
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# OPTIONAL API KEYS (for additional LLM models)
# =============================================================================

# OpenAI API Key (optional)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (optional)
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# DeepSeek API Key (optional)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# =============================================================================
# DATABASE CONFIGURATION (required)
# =============================================================================
# These values match the docker-compose.yml defaults for local development
# Change these if you're using a different database setup

DB_HOST=localhost
DB_PORT=3306
DB_NAME=manage_petro
DB_USER=mp_app
DB_PASS=devpass

# =============================================================================
# DATABASE CONNECTION POOLING (optional - production optimization)
# =============================================================================

# Connection pool size (default: 5 for local dev, 20 for production recommended)
# This is the number of connections maintained in the pool
# Lower for local dev to reduce resource usage
# Higher for production to handle concurrent requests
DB_POOL_SIZE=5

# Max overflow connections (default: 10 for local dev, 30 for production recommended)
# Additional connections beyond pool_size that can be created when needed
# These connections are closed when no longer in use
DB_MAX_OVERFLOW=10

# Pool recycle time in seconds (default: 3600)
# Connections older than this are recycled to prevent stale connections
# MySQL default wait_timeout is 28800s (8 hours)
# PostgreSQL keeps connections indefinitely unless configured otherwise
# 3600s (1 hour) is a safe default to prevent "server has gone away" errors
DB_POOL_RECYCLE=3600

# Pool pre-ping (default: True)
# Test connections before using them to catch stale connections
# Slightly increases latency but prevents errors from dead connections
# Should always be True in production
DB_POOL_PRE_PING=True

# Pool timeout in seconds (default: 30)
# How long to wait for a connection from the pool before timing out
# Lower values fail faster, higher values are more forgiving under load
DB_POOL_TIMEOUT=30

# =============================================================================
# JWT SECURITY CONFIGURATION (required)
# =============================================================================

# JWT Secret Key (required) - Generate a secure random key
# Run this command to generate a secure key:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here

# JWT Algorithm (optional, default: HS256)
JWT_ALGORITHM=HS256

# JWT Access Token Expiration in minutes (optional, default: 30)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Default LLM Model (optional, default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gpt-4, claude-3-sonnet, etc.
DEFAULT_LLM_MODEL=gemini-2.5-flash

# Default city for weather data (optional, default: Vancouver)
WEATHER_CITY=Vancouver

# Logging level (optional, default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# CORS CONFIGURATION (REQUIRED for production deployments)
# =============================================================================

# Allowed CORS origins (REQUIRED for production, optional for local dev)
# Comma-separated list of allowed frontend URLs for CORS
# 
# IMPORTANT: Production deployments MUST explicitly set this variable!
# If not set, only localhost origins are allowed (development only).
# 
# Examples for different deployment scenarios:
# - Single production frontend:
#   CORS_ORIGINS=https://your-frontend-domain.com
# 
# - Multiple frontends (production + staging):
#   CORS_ORIGINS=https://your-frontend.com,https://staging-frontend.com
# 
# - Local development + production:
#   CORS_ORIGINS=http://localhost:3000,https://your-frontend.com
#
# - Production Vercel deployment example:
#   CORS_ORIGINS=https://managepetro.vercel.app,https://manage-petro-frontend.vercel.app
#
CORS_ORIGINS=

# CORS Origin Regex Pattern (optional)
# Use regex pattern to match dynamic URLs (e.g., Vercel preview deployments)
# This is more flexible than listing individual URLs, especially useful for:
# - Preview deployments (Vercel, Netlify, etc.)
# - Multiple subdomains
# - Dynamic staging environments
#
# Examples:
# - Allow all Vercel preview deployments for your app:
#   CORS_ORIGIN_REGEX=https://.*-managepetro.*\.vercel\.app
#
# - Allow all subdomains of your domain:
#   CORS_ORIGIN_REGEX=https://.*\.your-domain\.com
#
# - Allow Vercel preview + production (use with CORS_ORIGINS for specific prod URL):
#   CORS_ORIGINS=https://manage-petro-frontend.vercel.app
#   CORS_ORIGIN_REGEX=https://managepetro-.*\.vercel\.app
#
# Important: Be specific with your regex to maintain security
# Bad example (too permissive): https://.*\.vercel\.app (allows ANY Vercel app)
# Good example: https://your-app-.*\.vercel\.app (allows only your app's previews)
#
# CORS_ORIGIN_REGEX=https://managepetro-.*\.vercel\.app
